# Konfigurasi docker-compose. Salin menjadi .env lalu isi semua yang kosong.
#   cp .env.example .env
#
# Berkas .env sudah masuk .gitignore — jangan pernah di-commit.

# ---- Alamat publik ----
# Port di host tempat stack ini didengarkan. Nilainya boleh diawali alamat
# bind, dan pilihan itu menentukan siapa yang bisa menjangkaunya:
#
#   PUBLIC_PORT=8080             terbuka dari internet
#   PUBLIC_PORT=127.0.0.1:8080   hanya dari dalam server
#
# Pakai bentuk kedua kalau ada reverse proxy (nginx + TLS) di host yang
# menjadi satu-satunya pintu masuk publik. Perlu diingat Docker menulis aturan
# iptables sendiri dan melewati ufw, jadi bentuk pertama benar-benar terbuka
# walaupun `ufw status` terlihat menutup port 8080.
PUBLIC_PORT=8080

# Origin yang diakses pengguna, tanpa path dan tanpa garis miring akhir.
# Backend selalu memasukkan nilai ini ke allow-list CORS-nya sendiri, jadi
# dashboard tidak pernah bisa terkunci dari endpoint login-nya sendiri.
PUBLIC_ORIGIN=http://localhost:8080

# Origin situs LAIN yang boleh memanggil API ini dari browser, dipisah koma.
# Dashboard Kosa sendiri TIDAK perlu disebut di sini — PUBLIC_ORIGIN di atas
# sudah menanganinya. Biarkan kosong kecuali ada storefront yang membaca
# /public/projects/<kode>/prices, misalnya:
#   CORS_ORIGINS=https://singgalang-ksb.com,https://www.singgalang-ksb.com
#
# Perlu diingat: mengizinkan origin di sini tidak menolong kalau storefront
# berjalan di https sementara API di http — browser memblokir campuran itu
# sebelum CORS sempat berperan.
CORS_ORIGINS=

# ---- Postgres ----
POSTGRES_USER=kosa
POSTGRES_DB=kosa
# Wajib diisi. Contoh: openssl rand -base64 24
POSTGRES_PASSWORD=

# ---- Auth ----
# Wajib diisi. Contoh: openssl rand -hex 32
# Mengganti nilai ini membuat semua sesi login yang sedang berjalan tidak valid.
JWT_SECRET=

# ---- Akun login pertama ----
# Hanya dipakai saat tabel users masih kosong, yaitu pada boot pertama.
# Mengubahnya setelah itu tidak berpengaruh — ganti password lewat aplikasi.
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=

# ---- Jaringan ----
# Rentang alamat nginx di jaringan bridge Docker. Ubah hanya kalau Anda
# memakai jaringan Docker dengan subnet khusus, atau menaruh proxy lain di
# depan tumpukan ini.
TRUSTED_PROXIES=172.16.0.0/12
