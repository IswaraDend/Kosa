# Konfigurasi docker-compose. Salin menjadi .env lalu isi semua yang kosong.
#   cp .env.example .env
#
# Berkas .env sudah masuk .gitignore — jangan pernah di-commit.

# ---- Alamat publik ----
# Port di loopback host tempat stack ini didengarkan. Tidak terbuka ke
# internet — taruh reverse proxy (nginx + TLS) di depannya.
PUBLIC_PORT=8080
# Origin yang akan diakses pengguna, tanpa path dan tanpa garis miring akhir.
PUBLIC_ORIGIN=http://localhost:8080
# Origin situs LAIN yang boleh memanggil API ini dari browser, dipisah koma.
# Frontend Kosa sendiri tidak perlu disebut karena satu origin dengan API.
# Isi kalau ada storefront yang membaca /public/projects/<kode>/prices:
#   CORS_ORIGINS=https://singgalang-ksb.com,https://www.singgalang-ksb.com
CORS_ORIGINS=http://localhost:8080

# ---- Postgres ----
POSTGRES_USER=kosa
POSTGRES_DB=kosa
# Wajib diisi. Contoh: openssl rand -base64 24
POSTGRES_PASSWORD=

# ---- Auth ----
# Wajib diisi. Contoh: openssl rand -hex 32
# Mengganti nilai ini membuat semua sesi login yang sedang berjalan tidak valid.
JWT_SECRET=

# ---- Akun login pertama ----
# Hanya dipakai saat tabel users masih kosong, yaitu pada boot pertama.
# Mengubahnya setelah itu tidak berpengaruh — ganti password lewat aplikasi.
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=

# ---- Jaringan ----
# Rentang alamat nginx di jaringan bridge Docker. Ubah hanya kalau Anda
# memakai jaringan Docker dengan subnet khusus, atau menaruh proxy lain di
# depan tumpukan ini.
TRUSTED_PROXIES=172.16.0.0/12
