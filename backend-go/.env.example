# ---- Database ----
# Managed Postgres (Railway/Render/Supabase/RDS) hampir selalu mewajibkan TLS:
# ganti sslmode=disable menjadi sslmode=require.
DB_DSN=host=localhost user=postgres password=password123 dbname=kosa port=5432 sslmode=disable TimeZone=UTC

# ---- Auth ----
# WAJIB diisi di deployment. Kalau kosong, server memakai kunci acak per-boot
# sehingga semua sesi login hangus setiap kali proses restart.
# Contoh membuat kunci: openssl rand -hex 32
JWT_SECRET=rahasia-super-kuat

# ---- CORS ----
# Origin frontend yang boleh memanggil API ini, dipisah koma.
# Harus origin saja (skema + host + port), tanpa path dan tanpa garis miring akhir.
CORS_ORIGINS=http://localhost:5173

# ---- HTTP ----
# Diisi otomatis oleh sebagian besar platform; default 8080 kalau kosong.
PORT=8080
# Alamat reverse proxy / load balancer di depan aplikasi, dipisah koma.
# Kosongkan kalau aplikasi diakses langsung — Gin akan berhenti mempercayai
# header X-Forwarded-For yang bisa dipalsukan siapa saja.
TRUSTED_PROXIES=

# ---- Seeder ----
# Dipakai HANYA saat tabel users masih kosong, untuk membuat akun login pertama.
# Kalau dibiarkan kosong, server memakai kredensial development yang tertulis
# di source code — jangan sampai itu terjadi di server publik.
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=

# ---- Secret key project (API eksternal) ----
# WAJIB diisi: 32 byte dalam bentuk hex (64 karakter). Kunci ini mengenkripsi
# secret key tiap project supaya Super Admin bisa melihatnya kembali.
# Server SENGAJA MENOLAK BOOT kalau kosong — berbeda dari JWT_SECRET. Kunci
# acak per-boot aman untuk menandatangani token, tapi di sini artinya semua
# secret key yang sudah tersimpan tidak bisa didekripsi lagi.
# Buat sekali lalu simpan permanen: openssl rand -hex 32
API_KEY_ENC_KEY=

# ---- Pembagian proses ----
# Rute mana yang didaftarkan proses ini. Kosongkan untuk keduanya, yang
# benar untuk pengembangan lokal dan untuk deployment satu proses.
#   app = /login, /super-admin, /admin, /member (tanpa /api/v1)
#   api = hanya /api/v1 (tukar token + baca produk)
# Nilai yang tidak dikenal menggagalkan boot, bukan diam-diam jadi keduanya.
SERVE_MODE=
# Apakah proses ini yang memiliki skema: menjalankan migrasi dan seeding.
# Default ya. Isi false HANYA pada proses kedua yang berbagi database dengan
# proses yang sudah memigrasikannya — dua proses yang meng-ALTER TABLE di
# boot yang sama adalah balapan. Lihat docker-compose.yml.
RUN_MIGRATIONS=
